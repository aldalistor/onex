{
  "name": "onex-complete-webapp",
  "version": "1.0.0",
  "description": "Oracle Forms ERP, AR, POS, finance and library analysis with Cloudflare Workers",
  "main": "src/index.ts",
  "type": "module",
  "scripts": {
    "build": "wrangler deploy --dry-run",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "deploy:prod": "wrangler deploy --env production",
    "test": "vitest",
    "test:coverage": "vitest --coverage",
    "migrate:prod": "wrangler d1 migrations apply onex-erp --remote",
    "migrate:local": "wrangler d1 migrations apply onex-erp --local",
    "migrate:test": "wrangler d1 migrations apply onex-erp --local --dry-run",
    "lint": "eslint src --ext .ts",
    "type-check": "tsc --noEmit"
  },
  "keywords": [
    "ERP",
    "Oracle Forms",
    "Finance",
    "Invoicing",
    "Inventory",
    "AR/AP",
    "Cloudflare Workers",
    "D1",
    "R2"
  ],
  "author": "Mohammed Aldali",
  "license": "MIT",
  "dependencies": {
    "itty-router": "^4.0.0",
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20240604.0",
    "@types/node": "^20.0.0",
    "typescript": "^5.0.0",
    "wrangler": "^3.0.0",
    "vitest": "^0.34.0",
    "@vitest/ui": "^0.34.0",
    "eslint": "^8.0.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0"
  }
}

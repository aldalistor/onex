# ONEX production configuration
NODE_ENV=production
PORT=3000
DATABASE_URL=mysql://user:password@127.0.0.1:3306/onex
ONEX_USE_DATABASE=1

# Local-only test login; disable in production
ENABLE_LOCAL_AUTH=false
LOCAL_AUTH_USERNAME=1
LOCAL_AUTH_PASSWORD=1

# Optional OAuth / platform session values
JWT_SECRET=replace-with-a-long-random-secret
OWNER_OPEN_ID=
VITE_ANALYTICS_ENDPOINT=
VITE_ANALYTICS_WEBSITE_ID=

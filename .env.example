# ONEX production configuration
NODE_ENV=production
PORT=3000
DATABASE_URL=mysql://user:password@127.0.0.1:3306/onex
ONEX_USE_DATABASE=1

# Local-only test login; disable in production
ENABLE_LOCAL_AUTH=false
LOCAL_AUTH_USERNAME=1
LOCAL_AUTH_PASSWORD=1

# Optional OAuth / platform session values
JWT_SECRET=replace-with-a-long-random-secret
OWNER_OPEN_ID=
VITE_ANALYTICS_ENDPOINT=
VITE_ANALYTICS_WEBSITE_ID=

# Oracle/FM​X bridge. Keep simulation in development; enable bridge only after
# the adapter has authenticated with the Oracle integration service.
ONEX_ORACLE_EXECUTION_MODE=simulation
ORACLE_BRIDGE_URL=http://127.0.0.1:8787
ORACLE_BRIDGE_TOKEN=
ORACLE_BRIDGE_TIMEOUT_MS=8000
